# VoiceFlow — Speech-to-intelligence
# Copy this file to .env and fill in the keys for whatever you actually plan
# to use. Nothing here is required just to boot the app — GET /health works
# with zero configuration, and every feature below degrades gracefully
# (with a clear error, not a crash) when its key is missing.

# ── LLM models — used by /analyze, /pipeline, /meeting/process, /call/analyze ──
LLM_DEFAULT=groq/llama-3.3-70b-versatile
LLM_REASONING=anthropic/claude-sonnet-4-6
LLM_JUDGE=anthropic/claude-haiku-4-5
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Transcription — used by /transcribe, /pipeline, WS /stream ──
# TRANSCRIPTION_PROVIDER is informational; ASR_PROVIDER below controls the
# actual remote fallback order, and VOICEFLOW_TRANSCRIPTION_MODE forces
# local-only or remote-only.
TRANSCRIPTION_PROVIDER=LOCAL_WHISPERX
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
VOICEFLOW_TRANSCRIPTION_MODE=
ASR_PROVIDER=remote,groq,deepgram,assemblyai
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# Local vs. remote is a decision you make per-capability, not all-or-nothing:
# LOCAL means the heavy model runs on this app's own host (needs the deps in
# requirements-ml.txt installed here — fine if this host has real hardware).
# REMOTE means delegating to a host you point at yourself — this app's own
# host stays lightweight. VOICEFLOW_REMOTE_ENDPOINT is a black box: whatever
# you run behind it (WhisperX, NeMo Canary, anything with diarization) is up
# to you — VoiceFlow just calls its /whisper route and reads the response.
VOICEFLOW_REMOTE_ENDPOINT=
VOICEFLOW_REMOTE_TOKEN=

# Which engine runs when in LOCAL mode specifically (irrelevant if you're
# using VOICEFLOW_REMOTE_ENDPOINT instead — remote is engine-agnostic).
LOCAL_ASR_ENGINE=whisperx
# LOCAL_ASR_ENGINE=nemo_canary   # NVIDIA's research-SOTA model — GPU
                                 # recommended; needs nemo_toolkit[asr],
                                 # see requirements-ml.txt. Uncomment the
                                 # nemo_toolkit line there too if you use this.

# ── Speaker diarization — used by local WhisperX/Canary and the remote endpoint ──
HF_TOKEN=
LOCAL_DIARIZATION_ENGINE=pyannote
# LOCAL_DIARIZATION_ENGINE=nemo  # CPU-capable alternative to pyannote — same
                                  # nemo_toolkit[asr] dependency as Canary above.

# ── Realtime voice agent — WS /realtime ──
# REALTIME_PROVIDER is a hard choice, not an auto-detected one: set it to
# "openai" or "gemini" and that is the provider used, using the matching key
# above (OPENAI_API_KEY or GEMINI_API_KEY). There is no fallback from one to
# the other — if you pick "openai" and only GEMINI_API_KEY is set, /realtime
# reports not-configured rather than silently using Gemini.
REALTIME_PROVIDER=openai
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Optional: point this at ANY service implementing the agent-tools discovery
# contract (see services/agent_tools_bridge.py) and its tools become callable
# by the model above mid-conversation. Not tied to a specific product — this
# project's own demo/dev target is AgentKit (github.com/Yacine-ai-tech/AgentKit),
# but nothing here assumes that. Empty by default: no tools, voice-only.
# Sent as X-AgentKit-Internal-Token when the downstream service requires it.
# AGENT_TOOLS_TOKEN falls back to AGENTKIT_INTERNAL_TOKEN (or generic
# INTERNAL_TOKEN) below if unset — set whichever matches how you already
# name it on the AGENT_TOOLS_URL deployment; unrelated to this project's own
# VOICEFLOW_INTERNAL_TOKEN further down.
AGENT_TOOLS_URL=
AGENT_TOOLS_TOKEN=
AGENT_TOOLS_CACHE_TTL=300

# ── Text-to-speech — POST /tts, provider=edge|elevenlabs|openai|kokoro ──
# edge-tts needs no key and is the default. Every other provider falls back
# to edge-tts automatically if its key is missing or the call fails.
ELEVENLABS_API_KEY=
# OPENAI_API_KEY above also covers provider=openai (tts-1-hd).
# provider=kokoro runs locally by default — needs
# `pip install -r requirements-ml.txt` (no API key). Same local/remote
# choice as transcription: if this host isn't beefy enough, delegate to a
# host you control instead of installing Kokoro's deps here.
VOICEFLOW_TTS_REMOTE_ENDPOINT=
VOICEFLOW_TTS_REMOTE_TOKEN=

# ── CORS & internal auth ──
CORS_ALLOWED_ORIGINS=http://localhost:8002,http://localhost:3000
# Gates this service's own POST endpoints behind X-VoiceFlow-Internal-Token
# when REQUIRE_INTERNAL_TOKEN=true. This is VoiceFlow's own inbound secret —
# unrelated to AGENT_TOOLS_TOKEN above, which is the outbound secret VoiceFlow
# sends when calling AGENT_TOOLS_URL.
VOICEFLOW_INTERNAL_TOKEN=
REQUIRE_INTERNAL_TOKEN=false

# ── Logging ──
LOG_LEVEL=INFO

# --- Telemetry ---
# Two anonymous pings, both to TELEMETRY_ENDPOINT/TELEMETRY_URL if set (no-op if neither is):
#  1. A startup ping (once per machine, at most every 6h) — {service, event:"startup",
#     version, instance_id}. This one is NOT affected by TELEMETRY_OPT_OUT below; it
#     always fires once an endpoint is configured.
#  2. A periodic aggregate usage snapshot (counts summed across sessions, no per-session
#     detail) — only sent if there's been activity, and only this one is skipped by
#     TELEMETRY_OPT_OUT=true.
# instance_id is a random UUID generated on first run, not derived from any hardware
# fingerprint. No user data (audio, transcripts, analysis output) is ever included.
# The public README also carries an embedded tracking-pixel image
# (gateway.ysiddo-ai-projects.app/pixel.png) that fires whenever the README is viewed
# with remote images enabled (e.g. on GitHub) — unrelated to the app itself, not
# affected by anything in this file.
TELEMETRY_OPT_OUT=false
TELEMETRY_URL=
