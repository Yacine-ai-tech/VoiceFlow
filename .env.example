# VoiceFlow configuration. Copy to `.env` and fill in what you use. Every value is read from the
# environment; nothing is hardcoded. Empty means "unset". Never commit a filled-in copy.

# ─── Server ──────────────────────────────────────────────────────────────────
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Python logging format string.
# LOG_FORMAT=
# Comma-separated browser origins allowed to call the API. "*" allows any (development only).
CORS_ALLOWED_ORIGINS=http://localhost:8002,http://localhost:3000
# Requests per client address per minute for HTTP routes (default 30)...
RATE_LIMIT_HTTP_PER_MIN=30
# ...and WebSocket connections per client address per minute (default 10).
RATE_LIMIT_WS_CONNECTS_PER_MIN=10
# Optional Postgres URL for session counters and saved voice records. Empty keeps everything
# in memory (reset on restart).
POSTGRES_URL=

# ─── Access control ──────────────────────────────────────────────────────────
# When true, every route except health, readiness, docs and static assets requires an
# internal token.
REQUIRE_INTERNAL_TOKEN=false
# Token(s) accepted when REQUIRE_INTERNAL_TOKEN=true. Any one is enough.
VOICEFLOW_INTERNAL_TOKEN=
INTERNAL_TOKEN=
OMNIINTEL_INTERNAL_TOKEN=
# Secret presented in X-Admin-Token to read or delete records across sessions.
ADMIN_TOKEN=

# ─── Language models (analysis) ──────────────────────────────────────────────
# LiteLLM identifiers in provider/model form. Default tier: meeting and general analysis.
LLM_DEFAULT=groq/openai/gpt-oss-120b
# Reasoning tier: sales-call and interview analysis.
LLM_REASONING=anthropic/claude-sonnet-4-6
# Judge tier: support-call analysis.
LLM_JUDGE=anthropic/claude-haiku-4-5
# Models tried when a tier fails authentication, billing or quota checks.
LLM_REASONING_FALLBACK=
LLM_JUDGE_FALLBACK=
# Last-resort models used when only Groq or only Gemini keys are available.
GROQ_FALLBACK_MODEL=groq/openai/gpt-oss-120b
GEMINI_FALLBACK_MODEL=gemini/gemini-2.5-flash
# Upper bound in seconds for one analysis call (default 60).
LLM_ANALYSIS_TIMEOUT_SECONDS=60
# Provider keys; only providers you reference need one. <PROVIDER>_API_KEYS (comma or whitespace
# separated) or extra <PROVIDER>_API_KEY_<suffix> variables are rotated round-robin;
# <PROVIDER>_KEY_SLOTS (for example "1,3") pins this deployment to a subset.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Base URL for an OpenAI-compatible endpoint used by OpenAI text-to-speech.
OPENAI_BASE_URL=

# ─── Speech to text ──────────────────────────────────────────────────────────
# Order in which providers are tried: remote, groq, deepgram, assemblyai. A provider without
# credentials is skipped.
ASR_PROVIDER=remote,groq,deepgram,assemblyai
# local runs the speech model on this host first; remote skips it. Empty = local when
# faster-whisper or whisperx is installed.
VOICEFLOW_TRANSCRIPTION_MODE=
# Allow loading the local model as a last resort when every provider failed. Set false on
# hosts with little memory.
ALLOW_LOCAL_ASR_FALLBACK=true
# Seconds to wait for one remote ASR call (default 120).
VOICEFLOW_ASR_TIMEOUT=120
# Remote ASR host (WhisperX or NeMo behind a URL you control) and its bearer token
# (INFERENCE_TOKEN is accepted as an alias).
VOICEFLOW_REMOTE_ENDPOINT=
VOICEFLOW_REMOTE_TOKEN=
INFERENCE_TOKEN=
# Provider label reported to /stream clients in the ready and ack messages.
TRANSCRIPTION_PROVIDER=LOCAL_WHISPERX
# Local engine: whisperx or nemo_canary.
LOCAL_ASR_ENGINE=whisperx
# Local WhisperX model size (tiny, base, small, medium, large-v3) and device (cpu or cuda).
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# NeMo Canary model identifier when LOCAL_ASR_ENGINE=nemo_canary.
# NEMO_CANARY_MODEL=
# Local speaker diarization engine: pyannote (GPU recommended) or nemo (CPU capable).
LOCAL_DIARIZATION_ENGINE=pyannote
# Hugging Face token for gated diarization models; PYANNOTE_TOKEN overrides it.
HF_TOKEN=
PYANNOTE_TOKEN=
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# Cloud provider models and keys.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
DEEPGRAM_MODEL=nova-3
DEEPGRAM_API_KEY=
ASSEMBLYAI_SPEECH_MODEL=best
ASSEMBLYAI_API_KEY=

# ─── Text to speech ──────────────────────────────────────────────────────────
# Default provider: edge (no key), elevenlabs, openai or kokoro. Any failing provider falls
# back to edge.
TTS_PROVIDER=edge
# Language model and sampling used when /tts translates text before speaking.
TTS_TRANSLATION_MODEL=
TTS_TRANSLATION_MAX_TOKENS=1024
TTS_TRANSLATION_TEMPERATURE=0.3
# Edge voices per language and gender, plus prosody offsets.
EDGE_TTS_VOICE_EN_FEMALE=en-US-AriaNeural
EDGE_TTS_VOICE_EN_MALE=en-US-GuyNeural
EDGE_TTS_VOICE_FR_FEMALE=fr-FR-DeniseNeural
EDGE_TTS_VOICE_FR_MALE=fr-FR-HenriNeural
EDGE_TTS_DEFAULT_RATE=+0%
EDGE_TTS_DEFAULT_VOLUME=+0%
# ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_DEFAULT_VOICE_MALE=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.5
ELEVENLABS_TIMEOUT_SECONDS=30.0
# OpenAI text to speech.
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE_FEMALE=nova
OPENAI_TTS_VOICE_MALE=onyx
OPENAI_TTS_VOICE_DEFAULT=alloy
OPENAI_TTS_RESPONSE_FORMAT=mp3
# Kokoro (self-hosted, needs the optional ML requirements).
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_MODEL_PATH=
KOKORO_LANG_CODE=a
KOKORO_VOICE_FEMALE=af_heart
KOKORO_VOICE_MALE=am_michael
KOKORO_VOICE_DEFAULT=af_heart
KOKORO_SAMPLE_RATE=24000
# Delegate Kokoro to a remote host instead of this process.
VOICEFLOW_TTS_REMOTE_ENDPOINT=
VOICEFLOW_TTS_REMOTE_TOKEN=
TTS_REMOTE_TIMEOUT=30.0
TTS_REMOTE_RETRIES=4

# ─── Real-time voice agent ───────────────────────────────────────────────────
# openai or gemini. A deliberate choice; there is no automatic switch between them.
REALTIME_PROVIDER=openai
# Explicit key for the selected provider. Empty uses GEMINI_API_KEY (gemini) or
# OPENAI_REALTIME_API_KEY / OPENAI_API_KEY (openai).
REALTIME_API_KEY=
OPENAI_REALTIME_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_VOICE_NAME=Zephyr

# ─── Agent tools (optional) ──────────────────────────────────────────────────
# Base URL of a service that exposes GET /api/tools (see services/agent_tools_bridge.py).
# Empty runs the voice agent without tools.
AGENT_TOOLS_URL=
# Token sent to that service. Falls back to AGENTKIT_INTERNAL_TOKEN / INTERNAL_TOKEN.
AGENT_TOOLS_TOKEN=
AGENTKIT_INTERNAL_TOKEN=
# Seconds a discovered tool list is cached (default 300) and how often it is refreshed in the
# background (default 120).
AGENT_TOOLS_CACHE_TTL=300
AGENT_TOOLS_PREWARM_INTERVAL_SECONDS=120
# Time budget for one tool call in seconds (default 2.0), HTTP timeout (default 8) and seconds
# an identical read result is reused (default 30).
AGENT_TOOLS_CALL_BUDGET_SECONDS=2.0
AGENT_TOOLS_HTTP_TIMEOUT_SECONDS=8
AGENT_TOOLS_RESULT_CACHE_TTL=30

# ─── Telemetry ───────────────────────────────────────────────────────────────
# Anonymous startup ping and periodic usage snapshot (counts and version only; no audio, text
# or keys). Disable with TELEMETRY_OPT_OUT=true or DO_NOT_TRACK=1.
TELEMETRY_OPT_OUT=false
DO_NOT_TRACK=
# Override the destination. Empty uses the project default.
TELEMETRY_ENDPOINT=
# Seconds between usage snapshots (default 1800).
TELEMETRY_USAGE_INTERVAL_SECONDS=1800

# ─── Frontend build (Vite) ───────────────────────────────────────────────────
# API base URL when the app is hosted separately. Empty = same origin.
VITE_API_BASE_URL=
# Dev server proxy target.
VITE_PROXY_TARGET=http://localhost:8002
