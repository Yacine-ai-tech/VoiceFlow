# VoiceFlow Environment Configuration

# STT / TTS Keys
GROQ_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Diarization (Optional)
HF_TOKEN=

# LLM Keys
ANTHROPIC_API_KEY=

# Settings
TRANSCRIPTION_PROVIDER=LOCAL_WHISPERX
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TELEMETRY_OPT_OUT=true

# E2E / Staging
# ADMIN_PASS: password for the E2E test admin login, must match the deployed admin account
ADMIN_PASS=
# OMNIINTEL_INTERNAL_TOKEN: shared secret for internal service-to-service auth, must match the value configured on the gateway and all other OmniIntel services
OMNIINTEL_INTERNAL_TOKEN=
