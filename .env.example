# VoiceFlow — Speech-to-intelligence
# Copy to .env and fill in your real keys

# LLM Models
LLM_DEFAULT=groq/llama-3.3-70b-versatile
LLM_REASONING=anthropic/claude-sonnet-4-6
LLM_JUDGE=anthropic/claude-haiku-4-5
GEMINI_API_KEY=

# API Keys
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
PYANNOTE_TOKEN=

# Transcription Configuration
TRANSCRIPTION_PROVIDER=LOCAL_WHISPERX
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:8002,http://localhost:3000
OMNIINTEL_INTERNAL_TOKEN=
REQUIRE_INTERNAL_TOKEN=false

# Logging & Telemetry
LOG_LEVEL=INFO
TELEMETRY_OPT_OUT=true
