# VoiceFlow Environment Configuration Template
# Copy this file to .env and fill in real credentials for deployment or local dev.

# Dedicated Neon Postgres database for session logs and transcription history
POSTGRES_URL=postgresql://voiceflow_owner:your_password@ep-your-endpoint.neon.tech/voiceflow?sslmode=require

# Primary LLM API Keys
GROQ_API_KEY=gsk_your_groq_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Transcription Provider Configuration
# TRANSCRIPTION_ENDPOINT is OpenAI-compatible and can be pointed to Groq, HuggingFace, or a local server (e.g. vLLM/Whisper)
TRANSCRIPTION_MODE=remote
TRANSCRIPTION_ENDPOINT=https://api.groq.com/openai/v1
TRANSCRIPTION_TOKEN=gsk_your_groq_key_here
WHISPER_MODEL=base

# Real-time Streaming Provider Configuration (options: openai | gemini)
REALTIME_PROVIDER=openai
REALTIME_API_KEY=your_openai_or_gemini_key_here

# Internal Auth Token for Inter-Service Requests
OMNIINTEL_INTERNAL_TOKEN=your_omniintel_internal_token_here

# CORS Allowed Origins (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://voiceflow-frontend.vercel.app

# Environment Mode (development | staging | production)
ENVIRONMENT=production
