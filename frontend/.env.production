# Production build config for the VoiceFlow frontend.
#
# The hosted frontend is separate from FastAPI, so production calls go through
# the Cloudflare gateway. If self-hosting FastAPI with frontend/dist served from
# the same origin, override this to an empty value at deploy time.
#
# If you deploy the frontend and backend to a different public backend, override
# VITE_API_BASE_URL in that hosting platform's environment configuration.
VITE_API_BASE_URL=https://gateway.ysiddo-ai-projects.app/voiceflow
VITE_API_URL=
REACT_APP_API_URL=
