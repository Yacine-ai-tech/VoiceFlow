# Production build config for the VoiceFlow frontend.
#
# Left blank on purpose: frontend/src/lib/api.ts falls back to same-origin relative
# fetches ("" + path) when VITE_API_BASE_URL is unset, which is correct for the
# self-hosting story in the Dockerfile (FastAPI serves frontend/dist/ itself, so
# frontend and backend share an origin, no base URL needed).
#
# If you deploy the frontend and backend SEPARATELY (e.g. Vercel frontend + a
# different backend host), set VITE_API_BASE_URL in your hosting platform's own
# environment-variable configuration (e.g. the Vercel project dashboard) at deploy
# time — don't hardcode a real URL into this file; it's a committed template shared
# by every clone of this repo.
VITE_API_BASE_URL=https://gateway.ysiddo-ai-projects.app/voiceflow
VITE_API_URL=
REACT_APP_API_URL=
